---
/**
 * Info sheet: adresa, Google Maps, telefon, email, web, društvene mreže, radno vrijeme.
 * Popover API (bez JS-a): otvara ga dugme s popovertarget, Esc / tap van zatvara.
 * Mobitel: bottom sheet; ≥640px: centriran dijalog.
 */
import Icon, { type IconName } from '../Icon.astro';
import type { Lang } from '../../config/site';
import { formatMinutes, useTranslations, weekdayName } from '../../i18n/utils';
import { buildWeekSchedule } from '../../lib/hours';
import type { Restaurant } from '../../lib/restaurants';

interface Props {
  id: string;
  restaurant: Restaurant;
  lang: Lang;
}

const { id, restaurant, lang } = Astro.props;
const r = restaurant.data;
const t = useTranslations(lang);

const SOCIAL_LABELS = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  tripadvisor: 'Tripadvisor',
} as const satisfies Record<keyof typeof r.socials, string>;

const socials = (Object.keys(SOCIAL_LABELS) as Array<keyof typeof SOCIAL_LABELS>)
  .map((key) => ({ key, url: r.socials[key], label: SOCIAL_LABELS[key], icon: key satisfies IconName }))
  .filter((s): s is typeof s & { url: string } => Boolean(s.url));

const schedule = buildWeekSchedule(r.workingHours);
const days = schedule
  .map((ranges, day) => ({ day, ranges }))
  .filter((d): d is { day: number; ranges: NonNullable<typeof d.ranges> } => d.ranges !== undefined);

const telHref = r.phone ? `tel:${r.phone.replace(/[^\d+]/g, '')}` : undefined;
const websiteHost = r.website ? new URL(r.website).host.replace(/^www\./, '') : undefined;
const titleId = `${id}-title`;
---

<div id={id} popover class="sheet" role="dialog" aria-labelledby={titleId}>
  <div class="sheet-head">
    <span class="grabber" aria-hidden="true"></span>
    <h2 id={titleId}>{r.name}</h2>
    <button class="close" type="button" popovertarget={id} popovertargetaction="hide">
      <Icon name="close" size={20} label={t('close')} />
    </button>
  </div>

  <div class="sheet-body">
    <section class="block">
      <h3 class="label"><Icon name="pin" size={16} />{t('address')}</h3>
      <p class="address">{r.address}</p>
      {
        r.googleMapsUrl && (
          <a class="btn btn--primary" href={r.googleMapsUrl} target="_blank" rel="noopener">
            <Icon name="pin" size={18} />
            {t('openInMaps')}
            <Icon name="external" size={16} class="ext" />
          </a>
        )
      }
    </section>

    {
      (r.phone || r.email || r.website) && (
        <section class="block contacts">
          {r.phone && (
            <a class="btn" href={telHref}>
              <Icon name="phone" size={18} />
              <span>
                {t('call')} <span class="muted">{r.phone}</span>
              </span>
            </a>
          )}
          {r.email && (
            <a class="btn" href={`mailto:${r.email}`}>
              <Icon name="mail" size={18} />
              <span class="truncate">{r.email}</span>
            </a>
          )}
          {r.website && (
            <a class="btn" href={r.website} target="_blank" rel="noopener">
              <Icon name="globe" size={18} />
              <span class="truncate">{websiteHost}</span>
            </a>
          )}
        </section>
      )
    }

    {
      socials.length > 0 && (
        <section class="block">
          <h3 class="label">{t('socials')}</h3>
          <ul class="socials">
            {socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="social">
                  <Icon name={s.icon} size={22} label={s.label} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      days.length > 0 && (
        <section class="block">
          <h3 class="label">
            <Icon name="clock" size={16} />
            {t('workingHours')}
          </h3>
          <table class="hours">
            <tbody>
              {days.map(({ day, ranges }) => (
                <tr data-day={day}>
                  <th scope="row">
                    {weekdayName(day, lang)}
                    <span class="today-tag">{t('today')}</span>
                  </th>
                  <td>
                    {ranges.length === 0 ? (
                      <span class="muted">{t('closed')}</span>
                    ) : (
                      ranges.map(({ open, close }) => (
                        <span class="range">
                          {formatMinutes(open)}–{formatMinutes(close)}
                        </span>
                      ))
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }
  </div>
</div>

<script>
  // Označi današnji dan u tabeli radnog vremena (vrijeme u Sarajevu).
  const weekday = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Sarajevo', weekday: 'short' }).format(new Date());
  const today = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(weekday);
  document.querySelector(`.hours tr[data-day="${today}"]`)?.classList.add('is-today');
</script>

<style>
  .sheet {
    position: fixed;
    inset: auto 0 0 0;
    margin: 0 auto;
    inline-size: min(100%, 34rem);
    max-block-size: min(88dvh, 44rem);
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 0;
    border-start-start-radius: var(--radius-xl);
    border-start-end-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
    padding-block-end: env(safe-area-inset-bottom);
    transition:
      translate calc(var(--duration) * 1.6) var(--ease),
      overlay calc(var(--duration) * 1.6) allow-discrete,
      display calc(var(--duration) * 1.6) allow-discrete;
    translate: 0 100%;
  }

  .sheet:popover-open {
    translate: 0 0;
  }

  @starting-style {
    .sheet:popover-open {
      translate: 0 100%;
    }
  }

  .sheet::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .sheet-head {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-3);
    background: var(--color-surface);
    border-block-end: 1px solid var(--color-border);
  }

  .grabber {
    grid-column: 1 / -1;
    justify-self: center;
    inline-size: 2.5rem;
    block-size: 4px;
    margin-block-end: var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  .sheet-head h2 {
    font-size: var(--text-xl);
  }

  .close {
    display: grid;
    place-items: center;
    inline-size: var(--tap-min);
    block-size: var(--tap-min);
    margin-inline-end: calc(var(--space-2) * -1);
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .close:hover {
    background: color-mix(in oklab, var(--color-text) 8%, transparent);
  }

  .sheet-body {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .block {
    display: grid;
    gap: var(--space-3);
  }

  .label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .address {
    font-size: var(--text-lg);
  }

  .btn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 3rem;
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--color-text) 5%, var(--color-surface));
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    min-inline-size: 0;
  }

  .btn:hover {
    background: color-mix(in oklab, var(--color-text) 9%, var(--color-surface));
  }

  .btn--primary {
    justify-content: center;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 600;
  }

  .btn--primary:hover {
    background: color-mix(in oklab, var(--color-primary) 88%, black);
  }

  .ext {
    opacity: 0.75;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .btn--primary .muted {
    color: inherit;
  }

  .truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .socials {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .social {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-text) 5%, var(--color-surface));
    color: var(--color-text);
  }

  .social:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .hours {
    inline-size: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .hours th,
  .hours td {
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  .hours th {
    font-weight: 400;
  }

  .hours td {
    text-align: end;
  }

  .range {
    display: block;
  }

  .today-tag {
    display: none;
    margin-inline-start: var(--space-2);
    padding: 0.1em 0.5em;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-xs);
    font-weight: 600;
    vertical-align: 0.1em;
  }

  .hours tr:global(.is-today) th,
  .hours tr:global(.is-today) td {
    font-weight: 600;
  }

  .hours tr:global(.is-today) .today-tag {
    display: inline-block;
  }

  @media (min-width: 640px) {
    .sheet {
      inset: 0;
      margin: auto;
      block-size: fit-content;
      border-radius: var(--radius-xl);
      translate: 0 1.5rem;
      opacity: 0;
      transition:
        translate calc(var(--duration) * 1.4) var(--ease),
        opacity calc(var(--duration) * 1.4) var(--ease),
        overlay calc(var(--duration) * 1.4) allow-discrete,
        display calc(var(--duration) * 1.4) allow-discrete;
    }

    .sheet:popover-open {
      translate: 0 0;
      opacity: 1;
    }

    @starting-style {
      .sheet:popover-open {
        translate: 0 1.5rem;
        opacity: 0;
      }
    }

    .grabber {
      display: none;
    }
  }
</style>
