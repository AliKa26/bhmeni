---
/**
 * Pretraga i filteri unutar menija (vanilla JS, bez frameworka).
 * Sva jela su već u HTML-u; skripta samo postavlja `hidden` na stavke, kategorije i pilule navigacije
 * na osnovu data-search / data-tags / data-allergens atributa.
 * Bez JS-a traka ostaje sakrivena (atribut hidden), a meni je normalno čitljiv.
 */
import Icon from '../Icon.astro';
import { LANGUAGES, type Lang } from '../../config/site';
import { localize, useTranslations } from '../../i18n/utils';

interface TaxonomyOption {
  id: string;
  icon: string;
  name: { bs: string } & Partial<Record<Lang, string>>;
}

interface Props {
  lang: Lang;
  /** Samo tagovi koji se pojavljuju u ovom meniju. */
  tags: TaxonomyOption[];
  /** Samo alergeni koji se pojavljuju u ovom meniju. */
  allergens: TaxonomyOption[];
}

const { lang, tags, allergens } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="filters"
  data-filters
  data-locale={LANGUAGES[lang].locale}
  data-t-one={t('results.one')}
  data-t-few={t('results.few')}
  data-t-other={t('results.other')}
  hidden
>
  <div class="search">
    <label for="menu-search" class="visually-hidden">{t('searchLabel')}</label>
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      id="menu-search"
      type="search"
      placeholder={t('searchPlaceholder')}
      autocomplete="off"
      enterkeyhint="search"
      spellcheck="false"
      data-filter-search
    />
  </div>

  {
    tags.length > 0 && (
      <div class="chip-row chip-row--scroll" role="group" aria-label={t('filterTags')}>
        {tags.map((tag) => (
          <button type="button" class="chip" aria-pressed="false" data-filter-tag={tag.id}>
            <span aria-hidden="true">{tag.icon}</span>
            {localize(tag.name, lang)}
          </button>
        ))}
      </div>
    )
  }

  {
    allergens.length > 0 && (
      <details class="allergen-filter">
        <summary>
          <span>{t('filterAllergens')}…</span>
          <span class="count" data-allergen-count hidden />
          <Icon name="chevron" size={16} class="chevron" />
        </summary>
        <div class="chip-row" role="group" aria-label={t('filterAllergens')}>
          {allergens.map((allergen) => (
            <button type="button" class="chip chip--exclude" aria-pressed="false" data-filter-allergen={allergen.id}>
              <span aria-hidden="true">{allergen.icon}</span>
              {localize(allergen.name, lang)}
            </button>
          ))}
        </div>
      </details>
    )
  }

  <div class="status-row" data-filter-status hidden>
    <p class="results" aria-live="polite" data-filter-results></p>
    <button type="button" class="clear" data-filter-clear hidden>{t('clearFilters')}</button>
  </div>
</div>

<script>
  import { matchesQuery, normalizeSearch } from '../../lib/search';

  const root = document.querySelector<HTMLElement>('[data-filters]');
  if (root) {
    root.hidden = false;

    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    const tagButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
    const allergenButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-allergen]')];
    const allergenCount = root.querySelector<HTMLElement>('[data-allergen-count]');
    const results = root.querySelector<HTMLElement>('[data-filter-results]');
    const statusRow = root.querySelector<HTMLElement>('[data-filter-status]');
    const clearButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-clear]')];
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')];
    const navItems = [...document.querySelectorAll<HTMLAnchorElement>('[data-category-nav] a[data-anchor]')];
    const plural = new Intl.PluralRules(root.dataset.locale);

    const pressed = (buttons: HTMLButtonElement[], attr: string) =>
      buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.getAttribute(attr) ?? '');

    const apply = () => {
      const query = normalizeSearch(search?.value ?? '');
      const requiredTags = pressed(tagButtons, 'data-filter-tag');
      const excluded = pressed(allergenButtons, 'data-filter-allergen');
      const active = query !== '' || requiredTags.length > 0 || excluded.length > 0;

      let visibleCount = 0;
      for (const item of items) {
        const itemTags = (item.dataset.tags ?? '').split(' ');
        const itemAllergens = (item.dataset.allergens ?? '').split(' ');
        const visible =
          matchesQuery(item.dataset.search ?? '', query) &&
          requiredTags.every((tag) => itemTags.includes(tag)) &&
          !excluded.some((allergen) => itemAllergens.includes(allergen));
        item.hidden = !visible;
        if (visible) visibleCount++;
      }

      for (const section of sections) {
        const hasVisible = section.querySelector('[data-item]:not([hidden])') !== null;
        section.hidden = !hasVisible;
        const link = navItems.find((a) => a.dataset.anchor === section.id);
        if (link?.parentElement) link.parentElement.hidden = !hasVisible;
      }

      if (allergenCount) {
        allergenCount.hidden = excluded.length === 0;
        allergenCount.textContent = String(excluded.length);
      }
      if (results) {
        const key = `t${plural.select(visibleCount).replace(/^./, (c) => c.toUpperCase())}`;
        const template = root.dataset[key] ?? root.dataset.tOther ?? '{n}';
        results.textContent = active ? template.replace('{n}', String(visibleCount)) : '';
      }
      for (const button of clearButtons) button.hidden = !active;
      if (statusRow) statusRow.hidden = !active;
      if (empty) empty.hidden = visibleCount > 0;

      window.dispatchEvent(new CustomEvent('menu:filtered'));
    };

    const toggle = (button: HTMLButtonElement) => {
      button.setAttribute('aria-pressed', button.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      apply();
    };
    for (const button of [...tagButtons, ...allergenButtons]) {
      button.addEventListener('click', () => toggle(button));
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    search?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(apply, 150);
    });
    // Enter na mobitelu: zatvori tastaturu da se vide rezultati.
    search?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') search.blur();
    });

    for (const button of clearButtons) {
      button.addEventListener('click', () => {
        if (search) search.value = '';
        for (const b of [...tagButtons, ...allergenButtons]) b.setAttribute('aria-pressed', 'false');
        apply();
      });
    }

    // Preglednik može vratiti tekst u polje (back/forward) — primijeni odmah.
    if (search?.value) apply();
  }
</script>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
  }

  .search {
    position: relative;
  }

  .search-icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--space-4);
    translate: 0 -50%;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  input {
    inline-size: 100%;
    min-block-size: 3rem;
    padding-inline: calc(var(--space-4) + 18px + var(--space-3)) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: max(16px, var(--text-base)); /* 16px+ sprječava zoom na iOS-u */
    appearance: none;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: transparent;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Na mobitelu jedan red sa horizontalnim skrolom (da filteri ne guraju jela daleko dole). */
  .chip-row--scroll {
    flex-wrap: nowrap;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .chip-row--scroll::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 640px) {
    .chip-row--scroll {
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }

  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap-min);
    padding-inline: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .chip--exclude[aria-pressed='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }

  .allergen-filter summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--tap-min);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .allergen-filter summary::-webkit-details-marker {
    display: none;
  }

  .allergen-filter[open] summary {
    color: var(--color-text);
  }

  .allergen-filter :global(.chevron) {
    transition: rotate var(--duration) var(--ease);
  }

  .allergen-filter[open] :global(.chevron) {
    rotate: 180deg;
  }

  .count {
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.4rem;
    block-size: 1.4rem;
    padding-inline: 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-background);
    font-size: var(--text-xs);
  }

  .allergen-filter .chip-row {
    padding-block-end: var(--space-2);
  }

  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .results {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .clear {
    min-block-size: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
